# Copy to .env (never committed) and fill in.

# Context.dev API key: reads the applicants' links, CVs and the companies' sites.
CONTEXT_DEV_API_KEY=
# Other origins whose pages may call this app's API (/api/apply, /api/organiser), comma-separated.
# The landing page (4321) and the Overlap app (8443) in development are allowed by default.
# PRESELECT_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:8443

# LinkedIn developer app, for "sign in with LinkedIn" (Member Data Portability API).
# Optional: without these, LinkedIn profile links are still looked up through Context.dev.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# The app's own data product reads its owner's data (the default). An app LinkedIn has
# reviewed for other members' data uses r_dma_portability_3rd_party.
# LINKEDIN_SCOPE=r_dma_portability_self_serve
