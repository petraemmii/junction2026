---
// The card of /get-started: a login form in looks only. It takes no credentials: "Log in" submits a
// plain GET form to the platform (PLATFORM_URL: the Overlap app) with the handoff query
// (?from=get-started), which takes the visitor past the Overlap app's own login; "Sign up here" is a link to the same URL. Layout: get-started.css.
import { ArrowLeft, ChevronRight } from 'lucide-react'
import { PLATFORM_URL, platformEntryFields, platformEntryUrl } from '@/config'
import { sitePath } from '@/lib/base'

const LINKS = [
  { href: sitePath('/#how'), label: 'How it works' },
  { href: sitePath('/#talent'), label: 'For talent' },
]

const label = 'text-[13px] leading-none font-medium'
const input =
  'gs-input mt-2 block h-13 w-full squircle-md border border-line bg-white px-4 text-base text-ink placeholder:text-mute'
const quietLink = 'gs-link inline-flex min-h-11 items-center rounded-md underline-offset-4 hover:text-ink hover:underline'
---

<div class="gs-card squircle-xl bg-card">
  <div class="flex justify-end">
    <a href={sitePath('/')} class={`${quietLink} gap-1.5 text-sm font-medium text-ink/75`}>
      <ArrowLeft size={16} aria-hidden="true" />
      Back to home
    </a>
  </div>

  <div class="gs-card-body">
    <h1 class="font-display text-4xl leading-[1.05] font-extrabold tracking-[-0.03em]">Log in</h1>
    <p class="mt-2 text-ink/75">Welcome to Overlap.</p>

    <form class="mt-7" action={PLATFORM_URL} method="get" novalidate>
      {platformEntryFields(PLATFORM_URL).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
      {/* The two fields have no `name`, so a submit never carries what is typed in them: it goes
          nowhere, not even into the URL. */}
      <label class={label} for="gs-email">Email</label>
      <input
        id="gs-email"
        class={input}
        type="text"
        inputmode="email"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder="you@example.com"
      />
      <label class={`${label} mt-5 block`} for="gs-password">Password</label>
      <input id="gs-password" class={input} type="password" autocomplete="off" placeholder="Enter your password" />

      <p class="mt-3 flex items-start gap-2 text-[13px] leading-[1.45] text-ink/75">
        <span class="shrink-0 rounded-full bg-lime px-2 py-0.5 text-xs leading-[1.45] font-medium text-forest">Demo</span>
        <span>No account needed. Leave the fields empty or type anything: nothing is sent.</span>
      </p>

      <button
        type="submit"
        class="gs-button mt-5 flex h-14 w-full cursor-pointer items-center justify-center squircle-md bg-forest text-base font-medium text-white"
      >
        Log in
      </button>
    </form>

    <p class="mt-2 text-center text-sm text-ink/75">
      New to Overlap?{' '}
      <a href={platformEntryUrl(PLATFORM_URL)} class="gs-link inline-flex min-h-11 items-center rounded-md font-medium text-ink underline underline-offset-4">
        Sign up here
      </a>
    </p>

    <hr class="my-4 border-line" />

    <div class="gs-promo relative overflow-hidden squircle-lg bg-forest p-6 text-white">
      <div class="gs-promo-art" aria-hidden="true">
        <span class="gs-promo-lime"></span>
        <span class="gs-promo-coral"></span>
      </div>
      <h2 class="font-display text-lg leading-tight font-bold">Hosting an event?</h2>
      <p class="mt-1.5 text-[13px] leading-[1.45] text-white/75">List it on Overlap and meet the talent that fits your team.</p>
      <a href={sitePath('/#companies')} class="gs-promo-link mt-3 inline-flex items-center gap-1 rounded-md text-sm font-medium">
        For companies
        <ChevronRight size={16} aria-hidden="true" />
      </a>
    </div>
  </div>

  <div class="gs-card-foot flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-[13px] text-ink/75">
    {/* On phones and tablets the © line is here, at the bottom of the page (PhotoPanel has it on wide screens). */}
    <p class="min-[960px]:hidden">© 2026 Overlap</p>
    <nav class="ml-auto flex items-center gap-3" aria-label="About Overlap">
      {
        LINKS.map((link, i) => (
          <>
            {i > 0 && <span class="h-3.5 w-px bg-line" aria-hidden="true" />}
            <a href={link.href} class={quietLink}>
              {link.label}
            </a>
          </>
        ))
      }
    </nav>
  </div>
</div>
