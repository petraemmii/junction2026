---
// Site footer: one glass bar with the lockup, the tagline and plain text links to the page's
// sections. No "Get started" here: the page's fixed header shows it at all times. Self-contained
// (no hero.css).
import { EspooLockup } from '@/components/landing/EspooLockup'
import { sitePath } from '@/lib/base'

const LINKS = [
  { href: sitePath('/#how'), label: 'How it works' },
  { href: sitePath('/#talent'), label: 'For talent' },
  { href: sitePath('/#companies'), label: 'For companies' },
]
---

<footer
  class="site-footer mx-auto box-content max-w-[1120px] px-5 pb-[max(20px,env(safe-area-inset-bottom))] sm:px-8"
>
  {/* One column on small screens; two rows from 800px, with the links beside the lockup. Gaps and
      paddings are 16px or more around the lockup: Espoo's clear space is 0.41 of the logo's height
      (16.4px at 40px), and the tagline's letters start a few pixels inside its line box. */}
  <div
    class:list={[
      'glass grid gap-5 p-5 sm:px-7 sm:py-6',
      'min-[800px]:grid-cols-[1fr_auto] min-[800px]:items-center min-[800px]:gap-x-8 min-[800px]:gap-y-4',
    ]}
  >
    <a href={sitePath('/')} class="footer-logo justify-self-start">
      <EspooLockup />
    </a>
    <p class="text-[15px] text-ink-soft min-[800px]:col-start-1 min-[800px]:row-start-2">
      Events, companies and talent that fit.
    </p>
    <nav aria-label="Footer" class="min-[800px]:col-start-2 min-[800px]:row-start-1">
      {/* Plain text links, 36px high. The only hover state is an underline, with no transition. */}
      <ul class="flex flex-wrap gap-x-6 min-[800px]:justify-end">
        {
          LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                class="footer-link inline-flex min-h-9 items-center rounded-sm text-sm font-medium text-ink underline-offset-4 hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="text-sm text-ink-soft min-[800px]:col-start-2 min-[800px]:row-start-2 min-[800px]:text-right">
      © 2026 Overlap
    </p>
  </div>
</footer>

<style>
  /* The page header's lockup: Espoo's navy, 32px high on phones and 40px from 640px. */
  .footer-logo {
    --espoo-lockup-height: 32px;
    display: inline-flex;
    border-radius: 4px;
    color: #012169;
    line-height: 1;
  }
  @media (min-width: 640px) {
    .footer-logo {
      --espoo-lockup-height: 40px;
    }
  }

  .footer-logo:focus-visible,
  .footer-link:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 3px;
  }
</style>
