# Response headers for the Cloudflare Workers static assets in dist/. Cloudflare parses this
# file; it is not served itself. A request matching several rules gets all their headers.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Every response.
# CSP notes: Astro emits inline <script>s (island hydration) and inline styles, React islands
# render style="" attributes, and html-to-image (soap-bubble backdrops) renders data:/blob:
# images. WebGL needs nothing from CSP. Everything else is same-origin only. When the platform
# that /get-started opens (the app) is on another origin (PUBLIC_APP_URL), the root `build:site`
# script adds that origin to form-action in dist/_headers: the "Log in" form on /get-started
# submits a GET form to it ("Get started" itself goes to /get-started, same-origin).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Fingerprinted build output (scripts, styles, fonts, images): the file name changes whenever
# the content does.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Generated event images: stable URLs, so cache for a day and refresh in the background.
/events/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# The app (apps/app), copied to dist/app/ by the root `build:site` script.
# Its page gets its own policy in place of the one above (`!` removes a header set by an earlier
# rule; it must come after that rule). The app loads its fonts from Google Fonts (a CSS @import
# in apps/app/src/index.css) and has no inline scripts or styles (React sets styles through the
# CSSOM). Update this policy if .figma/make/site.json adds analytics or custom scripts. Its
# shortlist reads the pre-selection backend: the bundled one is same-origin (connect-src 'self');
# for one elsewhere (PUBLIC_PRESELECT_URL) `build:site` adds its origin to connect-src here.
# CSP only applies to documents and workers, so the other paths under /app/ keep the policy above,
# including the 404 page served for unknown ones (it needs the inline styles). The service worker
# only fetches same-origin URLs, which that policy allows.
# Cache-Control: the page and the service worker revalidate on every load (the page names the
# current build's fingerprinted files, sw.js is how clients notice an update).
/app/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; img-src 'self'; font-src 'self' https://fonts.gstatic.com; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache
/app/sw.js
  Cache-Control: no-cache

# The app's fingerprinted build output (Vite's assets/ folder).
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The pre-selection backend (apps/preselect), which the root `build:site` script bundles into the
# Worker. Its pages and API routes are not files, so no rule here reaches them: the Worker sets
# their headers itself (src/worker/handler.ts). These are its fingerprinted client files.
/preselect/_astro/*
  Cache-Control: public, max-age=31536000, immutable
